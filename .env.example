# Frontend (Next.js / Prisma) environment template.
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# Backend variables live in agentic-service/.env.example.

# Prisma SQLite database (dev). Absolute file: URL.
DATABASE_URL=file:./db/custom.db

# NextAuth - session cookie encryption + absolute URL of the frontend.
# Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# FastAPI backend origin (server-side only - proxies + NextAuth callbacks).
BACKEND_URL=http://localhost:8001
