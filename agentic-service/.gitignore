# .gitignore — OpsPilot AI agentic service

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
build/
dist/
develop-eggs/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
MANIFEST

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ── Environment & secrets (NEVER commit) ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── IDE / editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing / coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.cache

# ── Type checkers / linters ─────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Trained models / pickled artifacts (we never commit these) ──────────────
models/*.pkl
models/*.joblib
models/*.bin
*.pkl
*.joblib

# ── Local DBs / runtime data ────────────────────────────────────────────────
*.sqlite3
*.db
db/*.db
langfuse_data/
postgres_data/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
