# .env.example — Tevet-7 environment template
#
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# This file documents every variable the service reads via app/config.py.

# ─────────────────────────────────────────────────────────────────────────────
# Control-plane database (asyncpg URL format)
# This is the Tevet-7 internal DB: tenants, users, configs, audit logs.
# Tenant business DBs are configured per-tenant (see DP_API_BASE_URL below).
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tevet7:tevet7_dev_password@localhost:5432/tevet7

# ─────────────────────────────────────────────────────────────────────────────
# LLM provider
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────────────────────────────────────
# Langfuse (LLM observability, self-hosted)
# Create a project at http://localhost:3001 and copy the keys here.
# ─────────────────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_HOST=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# Drive Producteur connector (Phase 1+)
# The DP tenant's business data is exposed via a REST API (or a direct
# read-only Postgres replica). These creds are stored encrypted in the
# control-plane DB per-tenant; this is only the dev fallback.
# ─────────────────────────────────────────────────────────────────────────────
DP_API_BASE_URL=https://api.drive-producteur.example.com/v1
DP_API_TOKEN=replace-me-with-a-real-bearer-token

# ─────────────────────────────────────────────────────────────────────────────
# Auth (JWT)
# The Next.js frontend mints JWTs signed with this secret. The agentic service
# verifies them and extracts: tenant_id, user_id, role, scope_value (e.g.
# producer_id). The client MUST NOT be trusted to send role/scope in the body
# for production traffic — see app/api/chat.py.
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-openssl-rand-base64-32
JWT_ALGORITHM=HS256

# ─────────────────────────────────────────────────────────────────────────────
# Quotas & safety
# Hard cap per tenant per UTC day. Resets at 00:00 UTC. Tracked in the
# control-plane DB. Exceeding returns HTTP 429.
# ─────────────────────────────────────────────────────────────────────────────
TOKEN_QUOTA_PER_TENANT_PER_DAY=200000

# ─────────────────────────────────────────────────────────────────────────────
# Feature flags (Phase gates)
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_RAG=false                   # Phase 3: pgvector document search
ENABLE_HUMAN_IN_THE_LOOP=false     # Phase 4: write action approval queue
ENABLE_MULTI_TENANT_ONBOARDING=false  # Phase 5

# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────
ENV=development                    # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=*                     # comma-separated; lock down in prod
